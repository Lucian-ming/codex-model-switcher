{
  "name": "codex-model-switcher",
  "displayName": "Codex 模型切换器",
  "description": "在 VS Code 中自由管理与切换 OpenAI Codex 的第三方中转站、模型、推理强度与配置预设。",
  "version": "0.3.0",
  "publisher": "codex-model-switcher",
  "author": "Lucian-ming <fyt0091@tju.edu.cn>",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lucian-ming/codex-model-switcher.git"
  },
  "bugs": {
    "url": "https://github.com/Lucian-ming/codex-model-switcher/issues"
  },
  "homepage": "https://github.com/Lucian-ming/codex-model-switcher#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "codex",
    "openai",
    "provider",
    "model-switcher",
    "claude",
    "deepseek",
    "kimi",
    "openrouter"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codex-model-switcher",
          "title": "Codex 模型切换器",
          "icon": "resources/codex-icon.svg"
        }
      ]
    },
    "views": {
      "codex-model-switcher": [
        {
          "id": "codexModelSwitcher.current",
          "name": "当前生效状态"
        },
        {
          "id": "codexModelSwitcher.providers",
          "name": "服务商与模型"
        },
        {
          "id": "codexModelSwitcher.profiles",
          "name": "配置预设 (Profiles)"
        },
        {
          "id": "codexModelSwitcher.settings",
          "name": "工具与设置"
        }
      ]
    },
    "commands": [
      {
        "command": "codexModelSwitcher.switchModel",
        "title": "Codex: 切换模型 (跨中转站)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.switchProvider",
        "title": "Codex: 切换服务商",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.switchProfile",
        "title": "Codex: 切换配置预设",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.adjustReasoningEffort",
        "title": "Codex: 调整推理强度 (Reasoning Effort)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.overrideContextWindow",
        "title": "Codex: 自定义覆盖上下文容量 (Context Window)",
        "icon": "$(gear)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.resetContextWindow",
        "title": "Codex: 重置上下文容量至接口发现值",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.refreshModels",
        "title": "Codex: 刷新全部中转站模型",
        "icon": "$(refresh)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.testProvider",
        "title": "Codex: 测试中转站连通性",
        "icon": "$(pulse)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.manageProviders",
        "title": "Codex: 管理中转站 (添加/改名/删除/换Key)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.addProvider",
        "title": "Codex: 添加中转站",
        "icon": "$(add)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.editProvider",
        "title": "Codex: 修改中转站名称/地址",
        "icon": "$(edit)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.disableProvider",
        "title": "Codex: 禁用该中转站 (隐藏整站模型)",
        "icon": "$(circle-slash)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.enableProvider",
        "title": "Codex: 启用该中转站",
        "icon": "$(play)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.disableModel",
        "title": "Codex: 禁用此模型 (隐藏)",
        "icon": "$(eye-closed)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.enableModel",
        "title": "Codex: 启用此模型",
        "icon": "$(eye)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.toggleProviderEnabled",
        "title": "Codex: 启用 / 禁用该中转站",
        "icon": "$(circle-slash)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.toggleModelEnabled",
        "title": "Codex: 启用 / 禁用此模型",
        "icon": "$(eye-closed)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.deleteProviderDirectly",
        "title": "Codex: 删除该中转站",
        "icon": "$(trash)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.manageProfiles",
        "title": "Codex: 管理配置预设",
        "icon": "$(add)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.editBaseInstructions",
        "title": "Codex: 修改全局系统提示词 (Base Instructions)",
        "icon": "$(edit)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.createProjectInstructions",
        "title": "Codex: 在当前项目创建/编辑指令 (AGENTS.md)",
        "icon": "$(file-text)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.resetBaseInstructions",
        "title": "Codex: 恢复默认系统提示词",
        "icon": "$(discard)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.restartExtensionHost",
        "title": "Codex: 重启扩展主机 (Restart Extension Host)",
        "icon": "$(sync)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.reloadWindow",
        "title": "Codex: 重新加载窗口 (Reload Window)",
        "icon": "$(refresh)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.openConfig",
        "title": "Codex: 打开配置文件 (config.toml)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.restoreConfig",
        "title": "Codex: 恢复历史配置备份",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.diagnose",
        "title": "Codex: 运行系统与环境诊断",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.activateModelDirectly",
        "title": "Codex: 激活此模型 (立即切换)",
        "icon": "$(check)"
      },
      {
        "command": "codexModelSwitcher.applyProfileDirectly",
        "title": "Codex: 应用此预设"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexModelSwitcher.switchModel",
          "when": "view == codexModelSwitcher.current",
          "group": "navigation"
        },
        {
          "command": "codexModelSwitcher.addProvider",
          "when": "view == codexModelSwitcher.providers",
          "group": "navigation"
        },
        {
          "command": "codexModelSwitcher.refreshModels",
          "when": "view == codexModelSwitcher.providers",
          "group": "navigation"
        },
        {
          "command": "codexModelSwitcher.manageProfiles",
          "when": "view == codexModelSwitcher.profiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codexModelSwitcher.disableProvider",
          "when": "view == codexModelSwitcher.providers && viewItem == customProvider_enabled",
          "group": "inline@0"
        },
        {
          "command": "codexModelSwitcher.disableProvider",
          "when": "view == codexModelSwitcher.providers && viewItem == customProvider_enabled",
          "group": "1_state@1"
        },
        {
          "command": "codexModelSwitcher.enableProvider",
          "when": "view == codexModelSwitcher.providers && viewItem == customProvider_disabled",
          "group": "inline@0"
        },
        {
          "command": "codexModelSwitcher.enableProvider",
          "when": "view == codexModelSwitcher.providers && viewItem == customProvider_disabled",
          "group": "1_state@1"
        },
        {
          "command": "codexModelSwitcher.editProvider",
          "when": "view == codexModelSwitcher.providers && viewItem =~ /customProvider/",
          "group": "inline@1"
        },
        {
          "command": "codexModelSwitcher.editProvider",
          "when": "view == codexModelSwitcher.providers && viewItem =~ /customProvider/",
          "group": "2_manage@1"
        },
        {
          "command": "codexModelSwitcher.testProvider",
          "when": "view == codexModelSwitcher.providers && viewItem =~ /customProvider/",
          "group": "inline@2"
        },
        {
          "command": "codexModelSwitcher.testProvider",
          "when": "view == codexModelSwitcher.providers && viewItem =~ /customProvider/",
          "group": "2_manage@2"
        },
        {
          "command": "codexModelSwitcher.deleteProviderDirectly",
          "when": "view == codexModelSwitcher.providers && viewItem =~ /customProvider/",
          "group": "inline@3"
        },
        {
          "command": "codexModelSwitcher.deleteProviderDirectly",
          "when": "view == codexModelSwitcher.providers && viewItem =~ /customProvider/",
          "group": "3_delete@1"
        },
        {
          "command": "codexModelSwitcher.activateModelDirectly",
          "when": "view == codexModelSwitcher.providers && viewItem == modelItem_enabled",
          "group": "0_activate@1"
        },
        {
          "command": "codexModelSwitcher.disableModel",
          "when": "view == codexModelSwitcher.providers && viewItem == modelItem_enabled",
          "group": "inline@0"
        },
        {
          "command": "codexModelSwitcher.disableModel",
          "when": "view == codexModelSwitcher.providers && viewItem == modelItem_enabled",
          "group": "1_state@1"
        },
        {
          "command": "codexModelSwitcher.overrideContextWindow",
          "when": "view == codexModelSwitcher.providers && viewItem == modelItem_enabled",
          "group": "inline@1"
        },
        {
          "command": "codexModelSwitcher.overrideContextWindow",
          "when": "view == codexModelSwitcher.providers && viewItem == modelItem_enabled",
          "group": "2_config@1"
        },
        {
          "command": "codexModelSwitcher.enableModel",
          "when": "view == codexModelSwitcher.providers && viewItem == modelItem_disabled",
          "group": "inline@0"
        },
        {
          "command": "codexModelSwitcher.enableModel",
          "when": "view == codexModelSwitcher.providers && viewItem == modelItem_disabled",
          "group": "1_state@1"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codexModelSwitcher.switchModel",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Codex 模型切换器",
      "properties": {
        "codexModelSwitcher.autoInjectCatalog": {
          "type": "boolean",
          "default": true,
          "description": "自动将已启用的各中转站模型合并导出至 ~/.codex/model_catalog.json，使官方 Codex 扩展原生可直接多站切换。"
        },
        "codexModelSwitcher.autoRefreshIntervalMinutes": {
          "type": "number",
          "default": 360,
          "description": "自动刷新服务商模型列表的周期（分钟，0为禁用）。"
        },
        "codexModelSwitcher.logLevel": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARN", "ERROR"],
          "default": "INFO",
          "description": "Codex 模型切换器输出通道的日志详细程度。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
