{
  "name": "codex-model-switcher",
  "displayName": "Codex 模型切换器",
  "description": "在 VS Code 中自由管理与切换 OpenAI Codex 的第三方中转站、模型、推理强度与配置预设。",
  "version": "0.2.1",
  "publisher": "codex-model-switcher",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/codex-model-switcher/codex-model-switcher"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "codex",
    "openai",
    "provider",
    "model-switcher",
    "claude",
    "deepseek",
    "kimi",
    "openrouter"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codex-model-switcher",
          "title": "Codex 模型切换器",
          "icon": "resources/codex-icon.svg"
        }
      ]
    },
    "views": {
      "codex-model-switcher": [
        {
          "id": "codexModelSwitcher.current",
          "name": "当前生效状态"
        },
        {
          "id": "codexModelSwitcher.providers",
          "name": "服务商与模型"
        },
        {
          "id": "codexModelSwitcher.profiles",
          "name": "配置预设 (Profiles)"
        },
        {
          "id": "codexModelSwitcher.settings",
          "name": "工具与设置"
        }
      ]
    },
    "commands": [
      {
        "command": "codexModelSwitcher.switchModel",
        "title": "Codex: 切换模型",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.switchProvider",
        "title": "Codex: 切换服务商",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.switchProfile",
        "title": "Codex: 切换配置预设",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.adjustReasoningEffort",
        "title": "Codex: 调整推理强度 (Reasoning Effort)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.overrideContextWindow",
        "title": "Codex: 自定义覆盖上下文容量 (Context Window)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.resetContextWindow",
        "title": "Codex: 重置上下文容量至接口发现值",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.refreshModels",
        "title": "Codex: 刷新服务商模型列表",
        "icon": "$(refresh)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.testProvider",
        "title": "Codex: 测试服务商连通状态",
        "icon": "$(pulse)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.manageProviders",
        "title": "Codex: 管理服务商 (添加/改名/换Key/删除)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.addProvider",
        "title": "Codex: 添加中转站 / 服务商",
        "icon": "$(add)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.editProvider",
        "title": "Codex: 修改中转站名字或端点",
        "icon": "$(edit)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.manageProfiles",
        "title": "Codex: 管理配置预设",
        "icon": "$(add)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.openConfig",
        "title": "Codex: 打开配置文件 (config.toml)",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.restoreConfig",
        "title": "Codex: 恢复历史配置备份",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.diagnose",
        "title": "Codex: 运行系统与环境诊断",
        "category": "Codex"
      },
      {
        "command": "codexModelSwitcher.activateModelDirectly",
        "title": "Codex: 激活此模型"
      },
      {
        "command": "codexModelSwitcher.applyProfileDirectly",
        "title": "Codex: 应用此预设"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexModelSwitcher.switchModel",
          "when": "view == codexModelSwitcher.current",
          "group": "navigation"
        },
        {
          "command": "codexModelSwitcher.addProvider",
          "when": "view == codexModelSwitcher.providers",
          "group": "navigation"
        },
        {
          "command": "codexModelSwitcher.refreshModels",
          "when": "view == codexModelSwitcher.providers",
          "group": "navigation"
        },
        {
          "command": "codexModelSwitcher.manageProfiles",
          "when": "view == codexModelSwitcher.profiles",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codexModelSwitcher.editProvider",
          "when": "view == codexModelSwitcher.providers && viewItem =~ /Provider/",
          "group": "inline"
        },
        {
          "command": "codexModelSwitcher.testProvider",
          "when": "view == codexModelSwitcher.providers && viewItem =~ /Provider/",
          "group": "inline"
        },
        {
          "command": "codexModelSwitcher.overrideContextWindow",
          "when": "view == codexModelSwitcher.providers && viewItem == modelItem",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codexModelSwitcher.switchModel",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "true"
      }
    ],
    "configuration": {
      "title": "Codex 模型切换器",
      "properties": {
        "codexModelSwitcher.autoInjectCatalog": {
          "type": "boolean",
          "default": true,
          "description": "自动将发现的第三方模型导出至 ~/.codex/model_catalog.json，使官方 Codex 扩展原生生效。"
        },
        "codexModelSwitcher.autoRefreshIntervalMinutes": {
          "type": "number",
          "default": 360,
          "description": "自动刷新服务商模型列表的周期（分钟，0为禁用）。"
        },
        "codexModelSwitcher.logLevel": {
          "type": "string",
          "enum": ["DEBUG", "INFO", "WARN", "ERROR"],
          "default": "INFO",
          "description": "Codex 模型切换器输出通道的日志详细程度。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "vsce package --no-dependencies",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
